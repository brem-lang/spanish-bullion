# Copy to .env (same folder as index.html) and fill in. Never commit or share .env.
# .htaccess blocks web access to it on Apache; on nginx, deny dotfiles yourself.

# CRM lead endpoint (https) and API key
BASE_ENDPOINT=
BASE_API_KEY=
# Optional
LEAD_FUNNEL=commodities-es
# Extra hosts allowed for the post-signup autologin redirect (the CRM's own host is always allowed)
LEAD_AUTOLOGIN_HOSTS=

# Cloudflare Turnstile secret key. Required on the live site, or every lead is rejected.
# The public site key goes in index.js (CONFIG.TURNSTILE_SITE_KEY).
TURNSTILE_SECRET_KEY=
# Optional comma list; captcha tokens from other hostnames are rejected
TURNSTILE_HOSTNAMES=

# 1 only when the site runs behind Cloudflare (then CF-Connecting-IP is the visitor IP)
TRUST_CLOUDFLARE=0
# Local testing only: IP sent to the CRM from localhost
DEV_IP_ADDRESS=

# Leads log: a copy of every lead the CRM accepted, with form timing. Server only.
# Without LEADS_LOG_API_KEY nothing is sent.
LEADS_LOG_ENDPOINT=https://alphamastercrm.online/api/leads-logs
LEADS_LOG_API_KEY=
